# HeatAware Hub Backend Configuration

# Application
APP_NAME=HeatAware Hub
APP_VERSION=1.0.0
DEBUG=False

# Database - PostgreSQL Configuration
# Format: postgresql://username:password@host:port/database_name
# You need to create the database first:
#   CREATE DATABASE heataware;
#   CREATE USER heataware_user WITH PASSWORD 'your_password';
#   GRANT ALL PRIVILEGES ON DATABASE heataware TO heataware_user;
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/heataware
DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=20

# Redis
REDIS_URL=redis://localhost:6379
REDIS_CACHE_TTL=300

# OpenWeather API
OPENWEATHER_API_KEY=your_api_key_here
OPENWEATHER_BASE_URL=https://api.openweathermap.org/data/2.5
OPENWEATHER_RATE_LIMIT=60

# Weather refresh intervals (seconds)
WEATHER_REFRESH_INTERVAL=600
WEATHER_FORECAST_REFRESH=3600

# Risk thresholds (Celsius)
HEAT_INDEX_LOW=27.0
HEAT_INDEX_MODERATE=32.0
HEAT_INDEX_HIGH=39.0
HEAT_INDEX_CRITICAL=51.0

# Humidity threshold (%)
HUMIDITY_THRESHOLD=60.0

# UV Index thresholds
UV_INDEX_HIGH=6.0
UV_INDEX_VERY_HIGH=8.0
UV_INDEX_EXTREME=11.0

# Player performance thresholds
PLAYER_FATIGUE_MODERATE=40.0
PLAYER_FATIGUE_HIGH=65.0
PLAYER_FATIGUE_CRITICAL=85.0

# Fan safety thresholds
FAN_RISK_MODERATE=35.0
FAN_RISK_HIGH=60.0
FAN_RISK_CRITICAL=80.0

# Match settings
MATCH_DURATION_MINUTES=90
HALFTIME_DURATION_MINUTES=15
COOLING_BREAK_THRESHOLD_TEMP=32.0

# Security
SECRET_KEY=change-this-to-a-random-secret-key-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# CORS Origins (comma-separated)
CORS_ORIGINS=["http://localhost:3000", "http://localhost:5173", "http://localhost:8080", "http://localhost:8000"]

# Logging
LOG_LEVEL=INFO